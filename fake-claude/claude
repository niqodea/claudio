#!/usr/bin/env python3
"""A stand-in for `claude` that answers each message with a tool call of several lines and its
result, then two text blocks in a row, as Claude Code's stream-json output carries them, and the
message `ask` with two questions of AskUserQuestion's, whose turn ends once they are answered: one
of one choice whose options have previews, and one of several choices. The command `/clear` starts
a new session, as Claude Code 2.1.322 does. Run claudio with this
directory first in PATH. FAKE_DELAY is how many seconds each answer waits before it starts, 0
when unset."""

import json
import os
import sys
import time

BLOCKS = ["The first block of text.", "The second block, right after the first."]

ASK_REQUEST_ID = "fake-ask"


def option(label, description, preview=None):
    return {"label": label, "description": description} | ({"preview": preview} if preview else {})


QUESTIONS = [
    {
        "question": "Which greeting function style do you prefer?",
        "header": "Code style",
        "options": [
            option("Arrow function", "Short one-liner.", "```js\nconst greet = (name) => `Hello, ${name}!`;\n```"),
            option(
                "Classic function",
                "Named function declaration.",
                "```js\nfunction greet(name) {\n  return `Hello, ${name}!`;\n}\n```",
            ),
        ],
    },
    {
        "question": "Which checks should CI run?",
        "header": "Checks",
        "multiSelect": True,
        "options": [option("Lint", ""), option("Tests", ""), option("Types", "")],
    },
]


def send(message):
    print(json.dumps(message), flush=True)


def state(name):
    send({"type": "system", "subtype": "session_state_changed", "state": name})


sessions = 1
send({"type": "system", "subtype": "init", "session_id": "fake-session", "claude_code_version": "2.1.322"})
state("idle")
for line in sys.stdin:
    message = json.loads(line)
    # claudio holds messages until the context's usage says how warm the cache is: a new session
    # has no usage. The usage also tells the model, the window and where Claude Code compacts
    if message.get("request", {}).get("subtype") == "get_context_usage":
        send(
            {
                "type": "control_response",
                "response": {
                    "subtype": "success",
                    "request_id": message["request_id"],
                    "response": {
                        "model": "claude-opus-5-5",
                        "maxTokens": 1_000_000,
                        "isAutoCompactEnabled": True,
                        "autoCompactThreshold": 967_000,
                        "apiUsage": None,
                    },
                },
            }
        )
    if message.get("request", {}).get("subtype") == "get_usage":
        now = int(time.time())
        send(
            {
                "type": "control_response",
                "response": {
                    "subtype": "success",
                    "request_id": message["request_id"],
                    "response": {
                        "rate_limits": {
                            "five_hour": {
                                "utilization": 62,
                                "resets_at": time.strftime('%Y-%m-%dT%H:%M:%S+00:00', time.gmtime(now + 2 * 3600)),
                            },
                            "seven_day": {
                                "utilization": 81,
                                "resets_at": time.strftime('%Y-%m-%dT%H:%M:%S+00:00', time.gmtime(now + 4 * 86400)),
                            },
                        }
                    },
                },
            }
        )
    # The answers to the questions end the turn that asked them
    if message.get("response", {}).get("request_id") == ASK_REQUEST_ID:
        send({"type": "result", "subtype": "success"})
        state("idle")
    if message.get("type") != "user":
        continue
    if message["message"]["content"] == "/clear" and not message.get("client_composed"):
        previous = "fake-session" if sessions == 1 else f"fake-session-{sessions}"
        sessions += 1
        send({"type": "conversation_reset", "trigger": "clear", "session_id": previous})
        send({"type": "system", "subtype": "init", "session_id": f"fake-session-{sessions}", "claude_code_version": "2.1.322"})
        send({"type": "result", "subtype": "success"})
        continue
    state("running")
    if message["message"]["content"].strip() == "ask":
        send(
            {
                "type": "control_request",
                "request_id": ASK_REQUEST_ID,
                "request": {
                    "subtype": "can_use_tool",
                    "tool_name": "AskUserQuestion",
                    "tool_use_id": "fake-ask-call",
                    "input": {"questions": QUESTIONS},
                },
            }
        )
        continue
    time.sleep(float(os.environ.get("FAKE_DELAY", "0")))
    send(
        {
            "type": "stream_event",
            "event": {
                "type": "message_start",
                "message": {
                    "usage": {
                        "input_tokens": 2,
                        "cache_creation_input_tokens": 41_201,
                        "cache_creation": {"ephemeral_1h_input_tokens": 41_201},
                    }
                },
            },
            "parent_tool_use_id": None,
        }
    )
    now = int(time.time())
    send(
        {
            "type": "rate_limit_event",
            "rate_limit_info": {
                "status": "allowed",
                "unifiedWindows": {
                    "five_hour": {"utilization": 0.62, "resetsAt": now + 2 * 3600},
                    "seven_day": {"utilization": 0.81, "resetsAt": now + 4 * 86400},
                },
            },
        }
    )
    send(
        {
            "type": "assistant",
            "message": {
                "content": [
                    {
                        "type": "tool_use",
                        "id": "fake-call",
                        "name": "Bash",
                        "input": {"command": "cd a\nmake", "description": "Build a"},
                    }
                ]
            },
            "parent_tool_use_id": None,
        }
    )
    send(
        {
            "type": "user",
            "message": {
                "content": [
                    {
                        "type": "tool_result",
                        "tool_use_id": "fake-call",
                        "content": "compiled a.c\nlinked a",
                        "is_error": False,
                    }
                ]
            },
            "parent_tool_use_id": None,
        }
    )
    for index, text in enumerate(BLOCKS):
        send(
            {
                "type": "stream_event",
                "event": {
                    "type": "content_block_delta",
                    "index": index,
                    "delta": {"type": "text_delta", "text": text},
                },
                "parent_tool_use_id": None,
            }
        )
        send(
            {
                "type": "assistant",
                "message": {"content": [{"type": "text", "text": text}]},
                "parent_tool_use_id": None,
            }
        )
    send({"type": "result", "subtype": "success"})
    state("idle")
