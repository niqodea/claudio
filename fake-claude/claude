#!/usr/bin/env python3
"""A stand-in for `claude` that answers each message with two text blocks in a row, as Claude
Code's stream-json output carries them. Run claudio with this directory first in PATH."""

import json
import sys

BLOCKS = ["The first block of text.", "The second block, right after the first."]


def send(message):
    print(json.dumps(message), flush=True)


def state(name):
    send({"type": "system", "subtype": "session_state_changed", "state": name})


send({"type": "system", "subtype": "init", "session_id": "fake-session"})
state("idle")
for line in sys.stdin:
    message = json.loads(line)
    # claudio holds messages until the context's usage says how warm the cache is: a new session
    # has no usage
    if message.get("request", {}).get("subtype") == "get_context_usage":
        send(
            {
                "type": "control_response",
                "response": {
                    "subtype": "success",
                    "request_id": message["request_id"],
                    "response": {},
                },
            }
        )
    if message.get("type") != "user":
        continue
    state("running")
    send(
        {
            "type": "stream_event",
            "event": {"type": "message_start", "message": {"usage": {"input_tokens": 1}}},
            "parent_tool_use_id": None,
        }
    )
    for index, text in enumerate(BLOCKS):
        send(
            {
                "type": "stream_event",
                "event": {
                    "type": "content_block_delta",
                    "index": index,
                    "delta": {"type": "text_delta", "text": text},
                },
                "parent_tool_use_id": None,
            }
        )
        send(
            {
                "type": "assistant",
                "message": {"content": [{"type": "text", "text": text}]},
                "parent_tool_use_id": None,
            }
        )
    send({"type": "result", "subtype": "success"})
    state("idle")
