#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"

cargo fmt --manifest-path "$root/Cargo.toml" --check
cargo clippy --quiet --manifest-path "$root/Cargo.toml" --all-targets -- --deny warnings
# A link to a check that is gone breaks the doc
RUSTDOCFLAGS='--deny warnings' cargo doc --quiet --no-deps --document-private-items --manifest-path "$root/Cargo.toml"
# What relies on undocumented behaviour of Claude Code says so only with a link to its check, which the doc checks
if git -C "$root" grep -n 'Undocumented' -- src ':!src/contract.rs' | grep -v 'Undocumented: \[.crate::contract::'; then
    >&2 echo 'Error: link what relies on undocumented behaviour of Claude Code to its check, as Undocumented: [crate::contract::<check>]'
    exit 1
fi
