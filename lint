#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"

cargo fmt --manifest-path "$root/Cargo.toml" --check
cargo clippy --quiet --manifest-path "$root/Cargo.toml" --all-targets -- --deny warnings
# A link to a check that is gone breaks the doc
RUSTDOCFLAGS='--deny warnings' cargo doc --quiet --no-deps --document-private-items --manifest-path "$root/Cargo.toml"
# What relies on undocumented behaviour of Claude Code says so only with a link to its check, which the doc checks
if git -C "$root" grep -n 'Undocumented' -- src ':!src/contract.rs' | grep -v 'Undocumented: \[.crate::contract::'; then
    >&2 echo 'Error: link what relies on undocumented behaviour of Claude Code to its check, as Undocumented: [crate::contract::<check>]'
    exit 1
fi
# Only VERSION names the Claude Code that claudio pins, since a copy anywhere else goes stale
# with the next version
# Ref: https://pragprog.com/tips/, Tip 15: "Every piece of knowledge must have a single,
# unambiguous, authoritative representation within a system"
version="$(sed -n 's/^pub const VERSION: &str = "\(.*\)";$/\1/p' "$root/src/claude_code.rs")"
if [ -z "$version" ]; then
    >&2 echo 'Error: lint cannot read VERSION in src/claude_code.rs'
    exit 1
fi
if git -C "$root" grep -n -F "$version" -- ':!src/claude_code.rs'; then
    >&2 echo "Error: Claude Code $version is written outside VERSION: use VERSION in code, a made-up version like 1.2.3 in a test or an example, and in a comment, a link to the contract check or the docs that back the fact"
    exit 1
fi
